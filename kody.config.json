{
  "$schema": "https://raw.githubusercontent.com/aharonyaircohen/kody-engine/main/kody.config.schema.json",
  "quality": {
    "typecheck": "pnpm typecheck",
    "lint": "pnpm lint",
    "testUnit": "pnpm test:unit"
  },
  "git": {
    "defaultBranch": "main"
  },
  "github": {
    "owner": "aharonyaircohen",
    "repo": "kody-chat",
    "operators": [
      "aguyaharonyair",
      "aharonyaircohen"
    ]
  },
  "agent": {
    "model": "minimax/MiniMax-M3"
  },
  "company": {
    "activeAgents": [
      "kody"
    ],
    "activeCapabilities": [
      "ci-health-check",
      "run",
      "review",
      "fix",
      "merge"
    ],
    "activeWorkflows": [
      "ci-repair"
    ]
  },
  "access": {
    "allowedAssociations": [
      "OWNER",
      "MEMBER",
      "COLLABORATOR"
    ]
  },
  "defaultExecutable": "run",
  "defaultPrExecutable": "fix"
}

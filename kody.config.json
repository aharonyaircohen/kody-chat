{
  "$schema": "https://raw.githubusercontent.com/aharonyaircohen/kody-engine/main/kody.config.schema.json",
  "quality": {
    "typecheck": "pnpm typecheck",
    "lint": "pnpm lint",
    "testUnit": "pnpm test:unit"
  },
  "git": {
    "defaultBranch": "main"
  },
  "github": {
    "owner": "aharonyaircohen",
    "repo": "kody-chat",
    "operators": [
      "aguyaharonyair",
      "aharonyaircohen"
    ]
  },
  "agent": {
    "model": "openrouter/deepseek/deepseek-v4-flash-0731"
  },
  "company": {
    "activeAgents": [
      "kody",
      "memory-steward",
      "qa"
    ],
    "activeCapabilities": [
      "qa-engineer"
    ],
    "activeWorkflows": [
      "qa-scan"
    ],
    "activePipelines": [
      "review-and-merge",
      "ci-repair"
    ]
  },
  "access": {
    "allowedAssociations": [
      "OWNER",
      "MEMBER",
      "COLLABORATOR"
    ]
  },
  "defaultImplementation": "run",
  "defaultPrImplementation": "fix"
}
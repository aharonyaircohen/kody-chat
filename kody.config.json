{
  "$schema": "https://raw.githubusercontent.com/aharonyaircohen/kody-engine/main/kody.config.schema.json",
  "quality": {
    "typecheck": "pnpm typecheck",
    "lint": "pnpm lint",
    "testUnit": "pnpm test:unit"
  },
  "git": {
    "defaultBranch": "main"
  },
  "github": {
    "owner": "aharonyaircohen",
    "repo": "kody-chat",
    "operators": [
      "aguyaharonyair",
      "aharonyaircohen"
    ]
  },
  "agent": {
    "model": "openrouter/deepseek/deepseek-v4-flash-0731"
  },
  "release": {
    "versionFiles": [
      {
        "path": "apps/dashboard/package.json",
        "kind": "package"
      }
    ],
    "version": {
      "readCommand": "node -e \"const fs=require('fs');const d=JSON.parse(fs.readFileSync('apps/dashboard/package.json','utf8'));process.stdout.write(d.version)\"",
      "writeCommand": "node -e \"const fs=require('fs');const p='apps/dashboard/package.json';const d=JSON.parse(fs.readFileSync(p,'utf8'));d.version=process.env.KODY_RELEASE_VERSION;fs.writeFileSync(p,JSON.stringify(d,null,2)+'\\n')\"",
      "files": [
        "apps/dashboard/package.json"
      ]
    },
    "validation": {
      "workflow": "release-validation.yml"
    },
    "releaseBranch": "main",
    "productionDeployRequired": true,
    "productionUrl": "https://kody-dashboard-sable.vercel.app",
    "smokeCommand": "curl -fsSL --max-time 30 \"${PRODUCTION_URL}/\" >/dev/null",
    "timeoutMs": 1800000
  },
  "company": {
    "activeAgents": [
      "kody",
      "memory-steward"
    ],
    "activeCapabilities": [
      "ci-health-check",
      "review",
      "fix",
      "merge",
      "extract-run-learning",
      "detect-memory-duplicates",
      "detect-memory-conflicts",
      "decide-memory-change",
      "apply-memory-changes",
      "verify-memory-change",
      "detect-stale-memory",
      "release-prepare",
      "release-validate",
      "ui-review",
      "prepare-ci-repair",
      "quality-check",
      "fix-ci",
      "run",
      "finalize-ci-repair",
      "prepare-strategy-application",
      "apply-strategy",
      "release-merge",
      "release-promote",
      "vercel-production-deploy"
    ],
    "activeWorkflows": [
      "ci-repair",
      "learn-from-runs",
      "maintain-memory-quality",
      "merge",
      "review-fix",
      "quality-run",
      "apply-strategy",
      "web-release"
    ],
    "activePipelines": [
      "review-and-merge",
      "ci-repair"
    ]
  },
  "access": {
    "allowedAssociations": [
      "OWNER",
      "MEMBER",
      "COLLABORATOR"
    ]
  },
  "defaultImplementation": "run",
  "defaultPrImplementation": "fix"
}
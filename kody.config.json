{
  "$schema": "https://raw.githubusercontent.com/aharonyaircohen/kody-engine/main/kody.config.schema.json",
  "quality": {
    "typecheck": "pnpm typecheck",
    "lint": "pnpm lint",
    "testUnit": "pnpm test:unit"
  },
  "git": {
    "defaultBranch": "main"
  },
  "github": {
    "owner": "aharonyaircohen",
    "repo": "kody-chat",
    "operators": [
      "aguyaharonyair",
      "aharonyaircohen"
    ]
  },
  "agent": {
    "model": "automatic",
    "automaticModels": [
      {
        "spec": "openrouter/free",
        "provider": "openrouter",
        "protocol": "openai",
        "baseURL": "https://openrouter.ai/api/v1",
        "modelName": "openrouter/free",
        "apiKeyEnvVar": "OPENROUTER_API_KEY"
      },
      {
        "spec": "openai/ox-alpha",
        "provider": "custom",
        "protocol": "openai",
        "baseURL": "https://oxalpha.run/api/v1",
        "modelName": "ox-alpha",
        "apiKeyEnvVar": "OXALPHA_API_KEY"
      },
      {
        "spec": "xkiro/deepseek/deepseek-v4-flash",
        "provider": "xkiro",
        "protocol": "openai",
        "baseURL": "https://api.xkiro.com/v1",
        "modelName": "deepseek/deepseek-v4-flash",
        "apiKeyEnvVar": "XKIRO_API_KEY"
      },
      {
        "spec": "openrouter/deepseek/deepseek-v4-flash-0731",
        "provider": "openrouter",
        "protocol": "openai",
        "baseURL": "https://openrouter.ai/api/v1",
        "modelName": "deepseek/deepseek-v4-flash-0731",
        "apiKeyEnvVar": "OPENROUTER_API_KEY"
      }
    ]
  },
  "company": {
    "activeAgents": [
      "kody",
      "memory-steward",
      "qa"
    ],
    "activeCapabilities": [
      "ci-health-check",
      "review",
      "fix",
      "merge",
      "extract-run-learning",
      "detect-memory-duplicates",
      "detect-memory-conflicts",
      "decide-memory-change",
      "apply-memory-changes",
      "verify-memory-change",
      "detect-stale-memory",
      "release-prepare",
      "release-validate",
      "ui-review",
      "prepare-ci-repair",
      "quality-check",
      "fix-ci",
      "run",
      "finalize-ci-repair",
      "prepare-strategy-application",
      "apply-strategy",
      "qa-engineer",
      "qa-issue-sync",
      "observe-repo-ci",
      "verify-strategy-application",
      "claim-next-backlog-issue",
      "reproduce",
      "plan",
      "comment-reviewed-issue-pull-request",
      "comment-stopped-issue-resolution"
    ],
    "activeWorkflows": [
      "ci-repair",
      "learn-from-runs",
      "maintain-memory-quality",
      "merge",
      "review-fix",
      "quality-run",
      "apply-strategy",
      "qa-scan",
      "qa-issue-sync",
      "qa-fix",
      "director-ci-monitor",
      "bug"
    ],
    "activePipelines": [
      "review-and-merge",
      "ci-repair",
      "qa-maintenance"
    ]
  },
  "access": {
    "allowedAssociations": [
      "OWNER",
      "MEMBER",
      "COLLABORATOR"
    ]
  },
  "defaultImplementation": "run",
  "defaultPrImplementation": "fix"
}
{
  "$schema": "https://raw.githubusercontent.com/aharonyaircohen/kody-engine/main/kody.config.schema.json",
  "quality": {
    "typecheck": "pnpm typecheck",
    "lint": "pnpm lint",
    "testUnit": "pnpm test:unit"
  },
  "git": {
    "defaultBranch": "main"
  },
  "github": {
    "owner": "aharonyaircohen",
    "repo": "kody-chat",
    "operators": [
      "aguyaharonyair",
      "aharonyaircohen"
    ]
  },
  "agent": {
    "model": "openrouter/free"
  },
  "company": {
    "activeAgents": [
      "kody",
      "memory-steward"
    ],
    "activeCapabilities": [
      "ci-health-check",
      "review",
      "fix",
      "merge",
      "extract-run-learning",
      "detect-memory-duplicates",
      "detect-memory-conflicts",
      "decide-memory-change",
      "apply-memory-changes",
      "verify-memory-change",
      "detect-stale-memory",
      "release-prepare",
      "release-validate",
      "ui-review",
      "prepare-ci-repair",
      "quality-check",
      "fix-ci",
      "run",
      "finalize-ci-repair",
      "prepare-strategy-application",
      "apply-strategy"
    ],
    "activeWorkflows": [
      "ci-repair",
      "learn-from-runs",
      "maintain-memory-quality",
      "merge",
      "review-fix",
      "quality-run",
      "apply-strategy",
      "web-release"
    ],
    "activePipelines": [
      "review-and-merge",
      "ci-repair"
    ]
  },
  "release": {
    "versionFiles": [
      {
        "path": "apps/dashboard/package.json",
        "kind": "package"
      }
    ],
    "validation": {
      "workflow": "release-validation.yml"
    },
    "releaseBranch": "main",
    "productionUrl": "https://kody-chat.vercel.app",
    "smokeCommand": "npx playwright test --project=chromium tests/e2e/smoke.spec.ts",
    "productionDeployRequired": true,
    "timeoutMs": 1800000
  },
  "access": {
    "allowedAssociations": [
      "OWNER",
      "MEMBER",
      "COLLABORATOR"
    ]
  },
  "defaultImplementation": "run",
  "defaultPrImplementation": "fix"
}
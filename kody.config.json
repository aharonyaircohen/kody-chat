{
  "$schema": "https://raw.githubusercontent.com/aharonyaircohen/kody-engine/main/kody.config.schema.json",
  "quality": {
    "typecheck": "pnpm typecheck",
    "lint": "pnpm lint",
    "testUnit": "pnpm test:unit"
  },
  "git": {
    "defaultBranch": "main"
  },
  "github": {
    "owner": "aharonyaircohen",
    "repo": "kody-chat",
    "operators": [
      "aguyaharonyair",
      "aharonyaircohen"
    ]
  },
  "agent": {
    "model": "openrouter/free"
  },
  "company": {
    "activeAgents": [
      "kody",
      "memory-steward"
    ],
    "activeCapabilities": [
      "ci-health-check",
      "run",
      "review",
      "fix",
      "merge",
      "extract-run-learning",
      "detect-memory-duplicates",
      "detect-memory-conflicts",
      "decide-memory-change",
      "apply-memory-changes",
      "verify-memory-change",
      "detect-stale-memory",
      "release-prepare",
      "release-validate",
      "release-merge",
      "release-promote",
      "vercel-production-deploy"
    ],
    "activeWorkflows": [
      "ci-repair",
      "learn-from-runs",
      "maintain-memory-quality",
      "web-release"
    ]
  },
  "access": {
    "allowedAssociations": [
      "OWNER",
      "MEMBER",
      "COLLABORATOR"
    ]
  },
  "defaultExecutable": "run",
  "defaultPrExecutable": "fix"
}